{
  "name": "relic-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare && nuxt prepare site",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && nuxt typecheck site",
    "gen:api": "cd .. && web/node_modules/.bin/buf generate --template buf.gen.web.yaml",
    "test": "vitest run",
    "test:e2e": "e2e/run.sh",
    "dev:site": "nuxt dev site",
    "generate:site": "NUXT_SITE_URL=https://relic.build NUXT_PUBLIC_RELIC_VERSION=\"$(scripts/release-version.sh)\" nuxt generate site"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/ui": "^4.12.0",
    "docus": "5.15.0",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/material-icon-theme": "^1.2.72",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/content": "3.16.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/mdc": "0.23.2",
    "@playwright/test": "1.64.1",
    "@scalar/nuxt": "0.6.81",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "happy-dom": "^21.0.3",
    "lighthouse": "13.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0"
}
