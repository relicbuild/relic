{
  "rclass": "federated",
  "key": "example-yum-federated",
  "projectKey": "example-projectKey",
  "environments": [
    "DEV"
  ],
  "packageType": "yum",
  "description": "example-description",
  "notes": "example-notes",
  "includesPattern": "**/*",
  "excludesPattern": "tmp/**",
  "repoLayoutRef": "simple-default",
  "blackedOut": true,
  "xrayIndex": true,
  "propertySets": [
    "artifactory"
  ],
  "downloadRedirect": true,
  "priorityResolution": true,
  "cdnRedirect": true,
  "primaryKeyPairRef": "example-primaryKeyPairRef",
  "secondaryKeyPairRef": "example-secondaryKeyPairRef",
  "archiveBrowsingEnabled": true,
  "members": [
    {
      "url": "https://example.com/yum",
      "enabled": true
    }
  ],
  "yumRootDepth": 3,
  "calculateYumMetadata": true,
  "enableFileListsIndexing": true,
  "yumGroupFileNames": "groups.xml"
}
