{
  "rclass": "federated",
  "key": "example-cargo-federated",
  "projectKey": "example-projectKey",
  "environments": [
    "DEV"
  ],
  "packageType": "cargo",
  "description": "example-description",
  "notes": "example-notes",
  "includesPattern": "**/*",
  "excludesPattern": "tmp/**",
  "repoLayoutRef": "simple-default",
  "blackedOut": true,
  "xrayIndex": true,
  "propertySets": [
    "artifactory"
  ],
  "downloadRedirect": true,
  "priorityResolution": true,
  "cdnRedirect": true,
  "primaryKeyPairRef": "example-primaryKeyPairRef",
  "secondaryKeyPairRef": "example-secondaryKeyPairRef",
  "archiveBrowsingEnabled": true,
  "members": [
    {
      "url": "https://example.com/cargo",
      "enabled": true
    }
  ],
  "cargoAnonymousAccess": true
}
