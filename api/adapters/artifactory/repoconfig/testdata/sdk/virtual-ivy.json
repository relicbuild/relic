{
  "rclass": "virtual",
  "key": "example-ivy-virtual",
  "projectKey": "example-projectKey",
  "environments": [
    "DEV"
  ],
  "packageType": "ivy",
  "description": "example-description",
  "notes": "example-notes",
  "includesPattern": "**/*",
  "excludesPattern": "tmp/**",
  "repoLayoutRef": "simple-default",
  "primaryKeyPairRef": "example-primaryKeyPairRef",
  "secondaryKeyPairRef": "example-secondaryKeyPairRef",
  "repositories": [
    "example-ivy-local"
  ],
  "artifactoryRequestsCanRetrieveRemoteArtifacts": true,
  "defaultDeploymentRepo": "example-ivy-local",
  "pomRepositoryReferencesCleanupPolicy": "discard_active_reference",
  "keyPair": "example-keyPair"
}
