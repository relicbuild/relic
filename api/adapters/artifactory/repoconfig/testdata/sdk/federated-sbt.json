{
  "rclass": "federated",
  "key": "example-sbt-federated",
  "projectKey": "example-projectKey",
  "environments": [
    "DEV"
  ],
  "packageType": "sbt",
  "description": "example-description",
  "notes": "example-notes",
  "includesPattern": "**/*",
  "excludesPattern": "tmp/**",
  "repoLayoutRef": "simple-default",
  "blackedOut": true,
  "xrayIndex": true,
  "propertySets": [
    "artifactory"
  ],
  "downloadRedirect": true,
  "priorityResolution": true,
  "cdnRedirect": true,
  "primaryKeyPairRef": "example-primaryKeyPairRef",
  "secondaryKeyPairRef": "example-secondaryKeyPairRef",
  "archiveBrowsingEnabled": true,
  "members": [
    {
      "url": "https://example.com/sbt",
      "enabled": true
    }
  ],
  "maxUniqueSnapshots": 3,
  "handleReleases": true,
  "handleSnapshots": true,
  "suppressPomConsistencyChecks": true,
  "snapshotVersionBehavior": "unique",
  "checksumPolicyType": "client-checksums"
}
