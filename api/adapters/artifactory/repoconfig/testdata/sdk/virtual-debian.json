{
  "rclass": "virtual",
  "key": "example-debian-virtual",
  "projectKey": "example-projectKey",
  "environments": [
    "DEV"
  ],
  "packageType": "debian",
  "description": "example-description",
  "notes": "example-notes",
  "includesPattern": "**/*",
  "excludesPattern": "tmp/**",
  "repoLayoutRef": "simple-default",
  "primaryKeyPairRef": "example-primaryKeyPairRef",
  "secondaryKeyPairRef": "example-secondaryKeyPairRef",
  "repositories": [
    "example-debian-local"
  ],
  "artifactoryRequestsCanRetrieveRemoteArtifacts": true,
  "defaultDeploymentRepo": "example-debian-local",
  "virtualRetrievalCachePeriodSecs": 600,
  "debianDefaultArchitectures": "amd64,arm64",
  "optionalIndexCompressionFormats": [
    "bz2"
  ]
}
