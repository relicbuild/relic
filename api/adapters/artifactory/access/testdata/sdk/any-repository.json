{
  "name": "example-any-repository",
  "repo": {
    "include-patterns": [
      "**"
    ],
    "exclude-patterns": [
      "**/*.tmp"
    ],
    "repositories": [
      "ANY LOCAL",
      "ANY REMOTE"
    ],
    "actions": {
      "groups": {
        "readers": [
          "read"
        ]
      }
    }
  }
}
