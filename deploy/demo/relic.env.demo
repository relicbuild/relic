# Settings the demo adds to /etc/relic/relic.env. CISA refuses the default
# KEV address from many hosting providers, so the catalog comes from its GitHub copy.
RELIC_SIGN_IN_NOTE=Sign in as demo / demo. This demo is read-only: look around, search, and pull with your own clients.
RELIC_TRUSTED_PROXIES=127.0.0.1/32,::1/128
RELIC_MAX_UPLOAD_SIZE=200MiB
RELIC_CVE_KEV_URL=https://raw.githubusercontent.com/cisagov/kev-data/main/known_exploited_vulnerabilities.json
